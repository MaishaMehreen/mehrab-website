---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import site from '../content/site.json';
import { email } from '../lib/links.js';

const { seo, pricing } = site;
const n = (i) => String(i + 1).padStart(2, '0');
---
<Base title={seo.pricing.title} description={seo.pricing.description} active="pricing">
  <section class="w" style="padding-top: clamp(56px, 7vw, 110px); padding-bottom: clamp(48px, 6vw, 80px); display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 32px">
    <div class="stack" style="gap: 20px">
      <p class="kick" data-fade style="margin: 0">Pricing</p>
      <h1 class="disp" style="margin: 0; font-size: clamp(56px, 9vw, 160px)">
        <span class="rise"><span>Simple,</span></span>
        <span class="rise"><span class="ac">project-based</span></span>
        <span class="rise"><span>pricing</span></span>
      </h1>
    </div>
    <div class="stack" data-fade style="gap: 20px; max-width: 460px">
      <p class="muted" style="margin: 0; font-size: 18px">{pricing.intro}</p>
      <div class="btns"><a class="btn btn-ac" href="/contact#quote">Discuss your project <Icon name="arrow" /></a></div>
    </div>
  </section>

  <!-- What shapes the price -->
  <section class="w stack" style="padding-top: 24px; padding-bottom: clamp(64px, 8vw, 110px); gap: 40px; border-top: 1px solid var(--line)">
    <div class="stack" style="gap: 12px; padding-top: clamp(40px, 5vw, 72px)">
      <span class="kick">01 — What shapes the price</span>
      <h2 class="disp" data-split style="margin: 0; font-size: clamp(44px, 6vw, 96px)">Six things<br /><span style="color: #7A7671">I look at</span></h2>
    </div>
    <div class="grid-auto" style="--min: 340px">
      {pricing.factors.map((f, i) => (
        <div class="box stack" data-reveal style="padding: 32px 28px; gap: 14px">
          <span class="disp ac" style="font-size: 48px">{n(i)}</span>
          <h3 class="disp" style="margin: 0; font-size: 30px">{f.title}</h3>
          <p class="muted" style="margin: 0">{f.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Ways to work together -->
  <section class="on-light">
    <div class="w stack" style="padding-top: clamp(72px, 9vw, 130px); padding-bottom: clamp(72px, 9vw, 130px); gap: 40px">
      <div class="stack" style="gap: 12px">
        <span class="kick-dark">02 — Ways to work together</span>
        <h2 class="disp" data-split style="margin: 0; font-size: clamp(44px, 6vw, 96px)">One video<br /><span style="color: #6B675F">or every week</span></h2>
      </div>
      <div class="grid-auto" style="--min: 280px">
        {pricing.options.map((o, i) => (
          <div class="stack" data-reveal style="border-top: 3px solid #0A0A0A; padding-top: 24px; gap: 12px">
            <span class="disp" style="font-size: 64px">{n(i)}</span>
            <h3 class="disp" style="margin: 0; font-size: 34px">{o.title}</h3>
            <p style="margin: 0; color: #3D3A36; font-size: 17px">{o.text}</p>
            <div class="chk" style="margin-top: 4px; font-weight: 700"><Icon name="check" />Price agreed before we start</div>
          </div>
        ))}
      </div>
      <div data-reveal style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 20px; padding-top: 28px; border-top: 1px solid #CFCBC3">
        <p style="margin: 0; font-size: 18px; font-weight: 600; max-width: 640px">{pricing.note}</p>
        <div class="btns">
          <a class="btn btn-dark" href="/contact#quote">Discuss your project <Icon name="arrow" /></a>
          <a class="btn btn-line-dark" href={email.href}>Email me</a>
        </div>
      </div>
    </div>
  </section>

  <CtaBand kicker="Have a project in mind?" lines={['Let’s talk', 'about it.']} primary={{ href: '/contact', label: 'Book a free call' }} secondary={{ href: '/contact#quote', label: 'Discuss your project' }} />
</Base>
