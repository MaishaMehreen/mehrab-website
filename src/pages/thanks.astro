---
// Shown after the quote form if JavaScript is off (Netlify redirects here).
import Base from '../layouts/Base.astro';
import { fiverr } from '../lib/links.js';
---
<Base title="Thanks! | Mehrab" description="Your request has been sent." noindex>
  <section class="w" style="padding-top: clamp(56px, 7vw, 110px); padding-bottom: clamp(72px, 9vw, 130px)">
    <div class="on-ac stack" style="padding: clamp(32px, 4vw, 56px); gap: 16px; max-width: 900px">
      <h1 class="disp" style="margin: 0; font-size: clamp(48px, 7vw, 96px)">Got it — thanks!</h1>
      <p style="margin: 0; font-size: 18px">Your request is in. Expect a reply within about an hour.</p>
      <div class="btns"><a class="btn btn-dark" href="/">Back to home</a><a class="btn btn-line-dark" href={fiverr} target="_blank" rel="noopener">Prefer Fiverr? Order here</a></div>
    </div>
  </section>
</Base>
