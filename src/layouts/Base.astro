---
import { ClientRouter } from 'astro:transitions';
import site from '../content/site.json';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  active?: string;
  overlayHeader?: boolean;
  noindex?: boolean;
}
const { title, description, active = '', overlayHeader = false, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const ogImage = new URL(`${base}og-image.png`, Astro.site).href;
const gaId = site.googleAnalyticsId;
---
<!doctype html>
<html lang="en" class="anim" style={`--ac: ${site.accentColor}`} transition:animate="none">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta name="theme-color" content="#0A0A0A" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={`${site.brand.logoText}.${site.brand.logoDomain}`} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="sitemap" href="/sitemap-index.xml" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Anton&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <!-- Hidden-until-animated states only apply while JS runs; this is the safety net if it never does. -->
  <script is:inline define:vars={{ base }}>
    (function () {
      var d = document.documentElement;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) { d.classList.remove('anim'); return; }
      try { if ((location.pathname === base || location.pathname + '/' === base) && sessionStorage.getItem('introSeen') !== '1') d.classList.add('intro-on'); } catch (e) {}
      setTimeout(function () { if (!window.__animStarted) d.classList.remove('anim', 'intro-on'); }, 2500);
    })();
  </script>
  <noscript><style>html.anim .rise > span, html.anim [data-fade], html.anim [data-reveal], html.anim [data-split] { transform: none !important; opacity: 1 !important; visibility: visible !important; }</style></noscript>

  {gaId && (
    <>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
      <script is:inline define:vars={{ gaId }}>
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { dataLayer.push(arguments); };
        gtag('js', new Date());
        gtag('config', gaId, { send_page_view: false });
      </script>
    </>
  )}

  <ClientRouter />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <div class="wipe" aria-hidden="true" transition:persist="wipe"></div>
  <slot name="intro" />
  <Header active={active} overlay={overlayHeader} />
  <main id="main">
    <slot />
  </main>
  <Footer />
  <script>
    import '../scripts/main.js';
  </script>
</body>
</html>
